#!/usr/bin/env bash
TOKEN=''
DOMAINS=''
ISP=""

CURL="curl --connect-timeout 5 --doh-url https://8.8.8.8/dns-query -fSs"
DIG="dig @8.8.8.8 ${DOMAINS}.duckdns.org +short +https"
DUCKURL="https://www.duckdns.org/update?domains=${DOMAINS}&token=${TOKEN}"

ipv4=$($CURL https://ipv4.json.myip.wtf 2>/dev/null)
[[ "$(echo ${ipv4} | jq -r .YourFuckingISP)" = "${ISP}" ]] && ipv4_addr=$(echo ${ipv4} | jq -r .YourFuckingIPAddress)
[[ -n "$ipv4_addr" ]] && echo "IPv4: $ipv4_addr" || echo url="${DUCKURL}&ip=&clear=true" | $CURL -K -
[[ "$($DIG A)" = "$ipv4_addr" ]] || echo url="${DUCKURL}&ip=${ipv4_addr}" | $CURL -K -

ipv6_addr=$($CURL https://ipv6.text.myip.wtf 2>/dev/null)
[[ -n "$ipv6_addr" ]] && echo "IPv6: $ipv6_addr" || echo url="${DUCKURL}&ipv6=&clear=true" | $CURL -K -
[[ "$($DIG AAAA)" = "$ipv6_addr" ]] || echo url="${DUCKURL}&ipv6=${ipv6_addr}" | $CURL -K -
