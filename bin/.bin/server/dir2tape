#!/usr/bin/env bash
MTX="/usr/local/bin/mtx"
MT="/usr/bin/mt"
SG="/usr/bin/sg_read_attr"
RE='^[0-9]+$'
DRIVE=${DRIVE:-0}
[[ $DRIVE =~ $RE ]] || exit 1
if [[ "$DRIVE" -eq 0 ]]; then
    TAPE=/dev/tape/by-path/pci-0000:0b:00.1-fc-0x2002000e11150604-lun-0-nst
elif [[ "$DRIVE" -eq 1 ]]; then
    TAPE=/dev/tape/by-path/pci-0000:85:00.0-sas-phy3-lun-0-nst
else
    echo "Drive not found"
    exit 1
fi
TAPEREWIND_TIMEOUT=300
TAPEREADY_TIMEOUT=3
TAPELIBRARY=/dev/tape/by-path/pci-0000:0b:00.1-fc-0x2002000e11150604-lun-1-changer
BS=${BS:-512}
[[ $BS =~ $RE ]] || exit 1
FILES_ONTAPE=0

function usage {
    echo "$(basename $0) [options] directory slot [nslots]"
    echo "options:"
    echo "[-f] Full Backup (will erase tape first)"
    echo "[-s] Statistics only"
    echo "[-v Verbose]"
    exit 1
}

while getopts "fsv" o; do
    case "${o}" in
    f) FULL=TRUE ;;
    s) STATS_ONLY=TRUE ;;
    v) VERBOSE=TRUE ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))

function findEOM {
    [[ -n $FULL ]] && eraseTape
    echo "Finding EOM..."
    local count=3
    while true; do
        $MT -f "${TAPE}" eom 2>/dev/null && break
        if [[ "${count}" -eq "0" ]]; then
            echo "EOM not found!"
            return 1
        fi
        ((count--))
        tapeRewind
    done
    echo "EOM found!"
    FILES_ONTAPE=$(($FILES_ONTAPE + $($MT -f "${TAPE}" status | grep 'file number' | awk '{print $4}')))
    echo "Files on Tape: $FILES_ONTAPE"
}

function unloadTape {
    local driveStatus=$($MTX -f ${TAPELIBRARY} status | grep "Data Transfer Element ${DRIVE}:")
    local driveLoaded=$(echo $driveStatus | awk -F ':' '{print $2}')
    [[ ${driveLoaded} == "Empty" ]] && return 0
    local storageSlot=$(echo $driveStatus | awk '{print $7}')
    $MTX -f $TAPELIBRARY unload $storageSlot $DRIVE
}

function tapeRewind {
    echo "Rewinding Tape..."
    timeout $TAPEREWIND_TIMEOUT $MT -f $TAPE rewind
}

function eraseTape {
    tapeRewind
    echo "Erasing Tape..."
    $MT -f $TAPE erase 0
}

function loadTape {
    unloadTape
    $MTX -f $TAPELIBRARY load $SLOT $DRIVE
}

function sizeRemain {
    $SG $TAPE -f 0x0 2>/dev/null | awk '{print $6}'
}

function find_select {
    if [[ -z $FULL && -e $DIR/lastTapeBackup ]]; then
        local lastBackup=$(stat -c %Y $DIR/lastTapeBackup)
        local now=$(date +%s)
        local nDays=$(((lastBackup - now) / 86400))
        [[ "$nDays" -eq 0 ]] && local nDays="-0"
        DAYS=("-mtime")
        DAYS+=($nDays)
    fi
    find $DIR -type f ${DAYS[@]} $@
}

function tar_cmd {
    tar --format=pax -T - -cf - 2>/dev/null
}

function mbuffer_send {
    local mbuffer_args=("--pid")
    [[ -z $VERBOSE ]] && mbuffer_args+=("-q")
    [[ $NSLOTS -gt $SLOT ]] && local mbuffer_args+=("-A $MTX -f $TAPELIBRARY next $DRIVE")
    mbuffer -s $((BS * 512)) -m 10% -o $TAPE "${mbuffer_args[@]}" 2>/dev/null
}

function sizeFiles {
    find_select "-printf %s\n" | awk '{sum += $1} END {print sum}'
}

function showFilesSize {
    local file_sizes=$(sizeFiles)
    local size_files_mb=$((file_sizes / 1048576))
    [[ "$size_files_mb" -ge 10000 ]] && echo "Files to backup: $((size_files_mb / 1024))GiB" || echo "Files to backup: ${size_files_mb}MiB"
}

function showRemainSize {
    local size_remain_mb=$(sizeRemain)
    [[ "$size_remain_mb" -ge 10000 ]] && echo "Remain space on tape: $((size_remain_mb / 1024))GiB" || echo "Remain space on tape: ${size_remain_mb}MiB"
}

function send2tape {
    echo "Sending to Tape.."
    [[ -z $FULL ]] && touch $DIR/lastTapeBackup
    find_select "-print0" | tar_cmd | mbuffer_send
}

function fullBackup {
    FULL=TRUE
    echo "Full Backup"
    send2tape
}

function partialBackup {
    echo "Partial Backup"
    send2tape
}

function main {

    if [ "$EUID" -ne 0 ]; then
        echo "Not running as root"
        exit 1
    fi

    DIR=$1
    SLOT=$2
    NSLOTS=${3:-0}
    NSLOTS=$((SLOT + NSLOTS))

    if [[ ! -d $DIR ]]; then
        echo directory invalid
        exit 1
    fi

    if [[ -n $STATS_ONLY ]]; then
        if [[ -z $FULL && -e $DIR/lastTapeBackup ]]; then
            echo "Partial Backup"
            echo "Last Backup: $(stat -c %y $DIR/lastTapeBackup)"
        else
            echo "Full Backup"
        fi
        echo -ne "Processing sizes...\r"
        showFilesSize
        exit 0
    fi

    [[ -z $SLOT ]] && usage

    if [[ -n $VERBOSE ]]; then
        echo "Directory: $DIR"
        echo "Blocksize: $((BS * 512 / 1024))kb"
        echo "TapeLibrary Storage: $SLOT..$NSLOTS"
    fi

    if [[ -z $FULL && $(sizeFiles) -lt 1048576 ]]; then
        echo "Nothing new to backup"
        exit 0
    fi

    echo "Begin of backup - $(date --utc +%Y/%m/%d-%H:%M)"

    if [[ $(tapeReady) == *'busy'* ]]; then
        echo "Tape Drive is Busy"
        exit 1
    fi
    
    loadTape $SLOT || exit $?

    if ! tapeReady >/dev/null; then
        echo "Tape Not Found!"
        exit 1
    fi
 
    if [[ ! -e $DIR/lastTapeBackup || -n $FULL ]]; then
        showFilesSize
        fullBackup
    else
        showFilesSize
        showRemainSize
        while [[ "$(($(sizeFiles) / 1048576))" -gt "$(sizeRemain)" ]]; do
            $MTX -f $TAPELIBRARY next $DRIVE
            showRemainSize
            if [[ $SLOT -eq $NSLOTS ]]; then
                echo "Last Tape full"
                unloadTape
                exit 2
            fi
            ((SLOT++))
        done
        findEOM
        partialBackup
    fi

    showRemainSize
    unloadTape

    echo "End of backup - $(date --utc +%Y/%m/%d-%H:%M)"
}

main $@
